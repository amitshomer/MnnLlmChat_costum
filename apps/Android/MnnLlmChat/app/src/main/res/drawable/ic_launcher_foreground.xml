        android:fillColor="#1A1F3C"
        android:pathData="M54,54 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0"/>
    <!-- Middle ring white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"/>
    <!-- Inner iris in background color -->
    <path
        android:fillColor="#1A1F3C"
        android:pathData="M54,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"/>
