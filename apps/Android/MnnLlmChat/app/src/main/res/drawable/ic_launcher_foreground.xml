        android:fillColor="#7EB8FF"
        android:pathData="M80,38 L81.6,42.4 L86,44 L81.6,45.6 L80,50 L78.4,45.6 L74,44 L78.4,42.4 Z"/>
    <!-- Small 4-point star -->
    <path
        android:fillColor="#7EB8FF"
        android:pathData="M87,33 L87.9,35.1 L90,36 L87.9,36.9 L87,39 L86.1,36.9 L84,36 L86.1,35.1 Z"/>
