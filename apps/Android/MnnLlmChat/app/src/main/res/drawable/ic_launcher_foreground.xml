    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Camera body ── -->
    <!-- Viewfinder bump on top -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,32 L44,29 C44,27.9 44.9,27 46,27 L62,27 C63.1,27 64,27.9 64,29 L64,32 Z"/>
    <!-- Main body rounded rect -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,32 C19.8,32 18,33.8 18,36 L18,72 C18,74.2 19.8,76 22,76
                          L86,76 C88.2,76 90,74.2 90,72 L90,36 C90,33.8 88.2,32 86,32 Z"/>

    <!-- ── Lens (hole cut out of body) ── -->
    <!-- Outer lens ring in background color -->
