    <path
        android:fillColor="#FFFFFF"
        android:pathData="M59,49 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>

    <!-- ── AI sparkle stars (top-right area of camera body) ── -->
    <!-- Large 4-point star -->
