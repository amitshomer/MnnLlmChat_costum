<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Toolbar: solid black, sits above preview -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_settings_24dp"
            app:navigationIconTint="#FFFFFF"
            app:titleTextColor="#FFFFFF"
            app:titleCentered="true"
            app:titleTextAppearance="?textAppearanceTitleMedium"
            tools:title="SmolVLM2" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CameraX live feed: fills from below toolbar to top of bottom bar -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shutter flash overlay (same area as preview) -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFFFF"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TTFT badge – top right, below toolbar -->
    <LinearLayout
        android:id="@+id/ttft_badge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_ttft_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#AA000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            tools:text="TTFT 1.2s"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_model_time_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#AA000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            tools:text="model 2.5s"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Dismissable response overlay – just above bottom bar -->
    <FrameLayout
        android:id="@+id/response_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_tips_response"
            android:paddingStart="16dp"
            android:paddingEnd="44dp"
            android:paddingVertical="14dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="6"
            android:ellipsize="end"
            tools:text="IMPROVE: Move the subject to the left third of the frame." />

        <ImageButton
            android:id="@+id/btn_dismiss_response"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_close"
            android:background="@android:color/transparent"
            android:focusableInTouchMode="false"
            android:contentDescription="Dismiss"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Bottom control bar: anchored to bottom, below preview -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#88000000"
        android:paddingBottom="16dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: zoom buttons (center) + AI-Tips button (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Zoom buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_zoom_1"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:focusableInTouchMode="false"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="1x"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:alpha="1.0"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_zoom_2"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:focusableInTouchMode="false"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="2x"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:alpha="0.5"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_zoom_3"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:focusableInTouchMode="false"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="3x"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:alpha="0.5"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/progress_thinking"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#FFFFFF"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <!-- AI-Tips / Thinking button -->
                    <Button
                        android:id="@+id/btn_ai_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/lookie_ai_tips_button"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/bg_button_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:minHeight="0dp"
                        android:focusableInTouchMode="false" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: gallery | capture | flip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp">

            <!-- Gallery thumbnail -->
            <ImageButton
                android:id="@+id/btn_gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_mute_circle"
                android:padding="0dp"
                android:scaleType="centerCrop"
                android:focusableInTouchMode="false"
                android:contentDescription="Gallery"
                android:layout_marginEnd="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Large capture button -->
            <ImageButton
                android:id="@+id/btn_capture"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_white"
                android:focusableInTouchMode="false"
                android:contentDescription="Capture" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Flip lens -->
            <ImageButton
                android:id="@+id/btn_flip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_camera_switch"
                android:background="@drawable/bg_mute_circle"
                android:padding="12dp"
                android:focusableInTouchMode="false"
                android:contentDescription="Flip camera" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
